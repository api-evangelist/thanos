{
  "opencollection": "1.0.0",
  "info": {
    "name": "Thanos Compact Alerts Health API",
    "version": "0.35.0"
  },
  "items": [
    {
      "info": {
        "name": "Health",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Thanos Liveness Check",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:10902/-/healthy"
          },
          "docs": "Returns HTTP 200 if the Compactor process is alive and running. Used as a liveness probe in Kubernetes deployments."
        },
        {
          "info": {
            "name": "Thanos Readiness Check",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:10902/-/ready"
          },
          "docs": "Returns HTTP 200 when the Compactor is ready. The Compactor runs as a long-lived process and this endpoint signals it has started and is actively compacting blocks."
        }
      ]
    }
  ],
  "bundled": true
}