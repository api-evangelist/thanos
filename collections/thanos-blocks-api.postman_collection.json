            },
            "url": {
              "path": [
                "api",
                "v1",
                "blocks"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "view",
                  "value": "<string>",
                  "description": "Specifies which blocks to include in the response. Use 'all' to see all tracked blocks, or filter by compaction state."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
