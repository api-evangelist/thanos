  "info": {
    "_postman_id": "e9f3a398-594e-4a27-b967-c6d8c5a629dc",
    "name": "Thanos Sidecar API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Thanos Sidecar HTTP API provides operational endpoints for the Sidecar component deployed alongside Prometheus instances. It exposes health, readiness, and metrics endpoints used for monitoring and orchestration. The Sidecar bridges Prometheus to the Thanos ecosystem by implementing the Thanos Store API over gRPC and optionally uploading blocks to object storage.\n\nContact Support:\n Name: Thanos Community",
      "type": "text/plain"
    }
